{
  "schemaVersion": 2,
  "entityTypes": [
    "resource",
    "skill",
    "concept",
    "prompt",
    "combination",
    "workflow"
  ],
  "paths": {
    "resource": "data/resources",
    "skill": "data/skills",
    "concept": "data/concepts",
    "prompt": "data/prompts",
    "combination": "data/combinations",
    "workflow": "data/workflows"
  },
  "requiredCommonFields": [
    "schemaVersion",
    "id",
    "entityType",
    "title",
    "status",
    "addedAt",
    "updatedAt",
    "tags"
  ],
  "referenceShape": {
    "type": "<entityType>",
    "id": "<stable-id>"
  },
  "rules": {
    "workflowIsFirstClass": true,
    "combinationOwnsExecutionOrder": false,
    "typedReferences": true,
    "oneRecordPerFile": true,
    "promptExtractionOnlyWhenIndependentlyReusable": true,
    "conceptMustBeToolIndependent": true,
    "problemLayerOptional": true,
    "graphIndexGenerated": true,
    "semanticLinksRequireEvidence": true
  },
  "futureIntake": [
    "research",
    "dedupe",
    "resource-or-skill",
    "concept",
    "combination",
    "workflow",
    "prompt-decision",
    "validate-references",
    "publish"
  ],
  "classificationV1": {
    "taxonomySource": "data/taxonomy-v1.json",
    "optional": true,
    "fields": {
      "primaryDomain": "required; one domain",
      "secondaryDomains": "0-2 valid domains",
      "purposeFacets": "learning/reference purposes",
      "contentFormat": "optional Resource source format",
      "formatEvidenceFields": "existing field paths",
      "capabilities": "[{id,evidenceFields,status}] optional assignments",
      "taxonomyVersion": "controlled vocabulary version"
    },
    "preserve": [
      "id",
      "entityType",
      "category",
      "resourceType",
      "tags",
      "typedReferences"
    ],
    "noImplicitRelations": true
  },
  "tagStandardizationV1": {
    "taxonomySource": "data/taxonomy-v1.json",
    "derivedIndex": "data/tag-index-v1.json",
    "dimensions": "taxonomy.tagDimensions",
    "vocabulary": "taxonomy.tagVocabulary",
    "legacyCategoryPreserved": true,
    "newIntakeReviewField": "intakeReview.tagReview",
    "unmappedKeywordsPreserved": true,
    "noImplicitDomainCapabilityEvidenceOrGraphLinks": true,
    "leanTagGovernance": "data/taxonomy-v1.json.tagGovernance",
    "newRecordMaxTags": 6,
    "maxNewTagsExistingRecord": 2,
    "newVocabularyNeedsAtLeastThreeRecordedUses": true,
    "newVocabularyRequiresWrittenDistinctnessAndBenefit": true,
    "historicalRawTagsPreservedByDefault": true,
    "reviewedRedundantLegacyTagCleanupAllowed": true,
    "cleanupMustPreserveSourcesAndKnowledge": true
  }
}
